# ─────────────────────────────────────────────────────────────
#  Fanvst Backend — plantilla de variables de entorno
#  Copia este archivo como .env y rellena tus valores reales.
# ─────────────────────────────────────────────────────────────

# Django core
SECRET_KEY=cambia-esta-clave-secreta
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Seguridad (False en desarrollo local sin HTTPS)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Base de datos PostgreSQL
DB_NAME=fanvst
DB_USER=fanvst_user
DB_PASSWORD=tu_password
DB_HOST=localhost
DB_PORT=5432

# Email
EMAIL_HOST=smtp.tuproveedor.com
EMAIL_HOST_USER=tu@email.com
EMAIL_HOST_PASSWORD=tu_password_email
EMAIL_PORT=587
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Fanvst <no-reply@fanvst.com>

# Celery / Redis
CELERY_BROKER_URL=redis://localhost
CELERY_TIMEZONE=America/Lima

# CORS — dominios permitidos (separados por coma)
CORS_ORIGIN_WHITELIST=http://localhost:4200,http://localhost:3000

# Google OAuth Client ID
GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com
